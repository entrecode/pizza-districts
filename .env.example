# Pizza Districts — environment variables
# Copy to .env.local for local dev. Never commit a populated .env file.
# CI MUST mask these values; never echo into logs.

# ─── Supabase (public, browser-safe) ─────────────────────────────
# Used by lib/supabase/browser.ts. Anon key is RLS-protected and OK to ship.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase (server-only, NEVER prefix with NEXT_PUBLIC_) ──────
# Used by lib/supabase/server.ts. Service-role key bypasses RLS — server only.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Maps & Places ────────────────────────────────────────
# Browser key for Maps JS SDK. MUST be domain-restricted in Google Cloud
# Console and scoped to Maps JS only (no Places, no Geocoding).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Server key for Places API. Used only by app/api/places/* and Edge Functions.
# MUST be IP-restricted in Google Cloud Console.
GOOGLE_PLACES_SERVER_KEY=

# ─── App ─────────────────────────────────────────────────────────
# Public site URL — used for Supabase auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Telemetry (optional; SDK no-ops when unset) ─────────────────
# When set, the browser SDK POSTs every event (track / error / page_view /
# custom) to this endpoint. Canary events (qa_canary=true) flow through the
# same endpoint — dashboard consumers default-exclude them.
# NEXT_PUBLIC_TELEMETRY_ENDPOINT=
# Server-side counterpart for route handlers / server actions / Edge Functions.
# TELEMETRY_ENDPOINT=
# Optional build/release tags stamped into event context.
# NEXT_PUBLIC_BUILD_ID=
# NEXT_PUBLIC_RELEASE=
