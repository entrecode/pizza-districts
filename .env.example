# Pizza Districts — environment variables
# Copy to .env.local for local dev. Never commit a populated .env file.
# CI MUST mask these values; never echo into logs.

# ─── Supabase (public, browser-safe) ─────────────────────────────
# Used by lib/supabase/browser.ts. Publishable key is RLS-protected and OK to ship.
# (Replaces the legacy `anon key` naming — Supabase deprecated the anon-key alias.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Supabase (server-only, NEVER prefix with NEXT_PUBLIC_) ──────
# Used by lib/supabase/server.ts. Service-role key bypasses RLS — server only.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Maps & Places ────────────────────────────────────────
# Browser key for Maps JS SDK. MUST be domain-restricted in Google Cloud
# Console and scoped to Maps JS only (no Places, no Geocoding).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Cloud Map ID for vector basemap + AdvancedMarker (POI labels off in cloud style).
NEXT_PUBLIC_GOOGLE_MAPS_STYLE_ID=

# Server key for Places API. Used only by app/api/places/* and Edge Functions.
# MUST be IP-restricted in Google Cloud Console.
GOOGLE_PLACES_SERVER_KEY=

# ─── App ─────────────────────────────────────────────────────────
# Public site URL — used for Supabase auth redirects.
# Canonical public origin for auth redirects. On Vercel you may omit this when
# deploying to *.vercel.app — the app falls back to https://$VERCEL_URL. Set
# explicitly for a custom domain so Supabase redirect URLs match production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Crash reporting (Sentry) — PIZ-65 ───────────────────────────
# When unset, every Sentry SDK init call no-ops. Source-map upload is also
# skipped. That is the intended state until ops provisions the project.
# Browser DSN (public): same Sentry project DSN, exposed to the client bundle.
# NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN: typically equal to NEXT_PUBLIC_SENTRY_DSN, but kept distinct
# so we can rotate one without the other if a leak ever occurs.
# SENTRY_DSN=
# Auth + project scoping for build-time source-map upload. ALL THREE required.
# SENTRY_AUTH_TOKEN= # secret — set in Vercel + GitHub Actions only.
# SENTRY_ORG=
# SENTRY_PROJECT=
# Optional release pin. When unset, the release identifier falls back to
# VERCEL_GIT_COMMIT_SHA (12-char short SHA), then NEXT_PUBLIC_BUILD_ID, then
# the literal "dev" sentinel. The same value is stamped into uploaded maps.
# SENTRY_RELEASE=
# Optional environment override. Default mapping: VERCEL_ENV=production → prod,
# VERCEL_ENV=preview → preview, otherwise dev.
# SENTRY_ENVIRONMENT=
# Smoke-test gate (PIZ-65 / Pre-Public-Build Checklist row 16). When set, the
# /api/sentry-smoke route accepts `Authorization: Bearer $TOKEN` and throws.
# SENTRY_SMOKE_TOKEN=
# Non-prod-only flag that opens the same route without a bearer for QA.
# Ignored in prod.
# NEXT_PUBLIC_SENTRY_SMOKE_ENABLED=
