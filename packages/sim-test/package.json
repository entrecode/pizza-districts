{
  "name": "@pd/sim-test",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tier1": "vitest run --reporter=verbose test/tier1.test.ts test/properties.test.ts test/canonical.test.ts test/streams.test.ts test/compare.test.ts",
    "test:tier2": "TIER=2 vitest run --reporter=verbose test/tier2.test.ts"
  },
  "dependencies": {
    "@pd/sim": "workspace:*",
    "@pd/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
